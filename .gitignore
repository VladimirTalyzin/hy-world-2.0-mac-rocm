# ---------------------------------------------------------------------------
# HY-World 2.0 — ROCm / MPS port. What stays out of the repository and why.
# ---------------------------------------------------------------------------

# Model weights: downloaded from Hugging Face by download_weights.py (~60 GB
# with the panorama base model). Never redistributed.
weights/

# Everything the pipelines and the web UI produce.
outputs/
viewer/results.html

# Python virtual environments.
venv/
venv-*/
.venv/
env/

# Header-only ROCm libraries fetched by tools/setup_rocm_thirdparty.sh for the
# gsplat HIP build (rocThrust, rocPRIM, hipCUB, glm).
third_party_rocm/

# ---- inside the vendored upstream tree ------------------------------------
# Upstream's README animations (215 MB of GIFs; the PNGs stay so its README
# still renders) and its demo inputs (120 MB). The worldrecon examples the UI
# offers are restored by
#   python download_weights.py --examples
HY-World-2.0/assets/*.gif
HY-World-2.0/assets/*.mp4
HY-World-2.0/examples/
# Sky-segmentation ONNX model, fetched on first reconstruction (168 MB).
HY-World-2.0/skyseg.onnx
# Weights that land inside the tree by mistake.
*.safetensors
*.ckpt
*.pth
# gsplat HIP build products: the hipified mirror, the generated host shims and
# the compiled extension. All regenerated by tools/build_gsplat_rocm.bat.
HY-World-2.0/hyworld2/worldgen/third_party/gsplat_maskgaussian/gsplat/hip/
HY-World-2.0/hyworld2/worldgen/third_party/gsplat_maskgaussian/gsplat/cuda/csrc/_hip_host/
HY-World-2.0/hyworld2/worldgen/third_party/gsplat_maskgaussian/build/
*.pyd
*.so
*.egg-info/
# recastnavigation: upstream carried it as a git submodule -- 207 files, 9.3 MB
# of unmodified C++ serving WorldNav (worldgen stages 1-2), which this port does
# not cover. navi_utils.py skips the navmesh build when the module is missing,
# and third_party/navmesh/setup.py prints what to do: clone
#   https://github.com/recastnavigation/recastnavigation
# into the path below, or point RECAST_PATH at your own checkout.
HY-World-2.0/hyworld2/worldgen/third_party/recastnavigation/

# Upstream's own scratch files.
HY-World-2.0/inference_output/
HY-World-2.0/gradio_demo_output/
HY-World-2.0/.gradio/
HY-World-2.0/CLAUDE.md
HY-World-2.0/commands.sh

# Python bytecode / tool caches.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Gradio.
gradio_cached_examples/
flagged/
.gradio/

# Editors.
*.swp
*.swo

# OS.
.DS_Store
._*
Thumbs.db
desktop.ini

# Logs.
*.log
